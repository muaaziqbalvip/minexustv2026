{
  "rules": {
    ".read": false,
    ".write": false,

    "app_config": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).val() === true"
    },

    "custom_servers": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).val() === true"
    },

    "custom_channels": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).val() === true"
    },

    "notifications": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).val() === true"
    },

    "inviteCodes": {
      ".read": "auth !== null",
      "$code": {
        ".write": "auth !== null && (!data.exists() || data.val() === auth.uid)"
      }
    },

    "admins": {
      ".read": "root.child('admins').child(auth.uid).val() === true",
      ".write": false
    },

    "users": {
      ".read": "auth !== null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth !== null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth !== null && auth.uid === $uid",

        "stats": {
          ".write": "auth !== null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
        },
        "referredBy": {
          ".write": "auth !== null && auth.uid === $uid && !data.exists()"
        }
      }
    },

    "leaderboard": {
      ".read": true,
      "$uid": {
        ".write": "auth !== null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'points', 'watchCount'])"
      }
    },

    "analytics": {
      ".read": "auth !== null && root.child('admins').child(auth.uid).val() === true",
      "daily": {
        "$day": {
          "events": {
            "$eventId": {
              ".write": "auth !== null && (!data.exists())"
            }
          },
          "summary": {
            ".write": "auth !== null"
          }
        }
      },
      "totals": {
        ".write": "auth !== null"
      }
    },

    "serverHealth": {
      ".read": true,
      "$titleId": {
        "lastGood": { ".write": "auth !== null" },
        "lastGoodAt": { ".write": "auth !== null" },
        "successCount": { ".write": "auth !== null" },
        "failCount": { ".write": "auth !== null" }
      }
    },

    "adAnalytics": {
      "_comment": "Written by ads-engine.js from EVERY page that shows ads, including the standalone Privacy Policy and Terms of Service pages — those pages don't run Firebase Auth at all (no sign-in flow, no anonymous auth), so this intentionally allows unauthenticated writes, unlike every other write path in this app. Scoped narrowly (append-only child pushes under 'loads'/'errors' only, never any read) so the worst a bad actor could do is push junk log entries — they can never read anyone's data or affect any other part of the app through this path.",
      ".read": "auth !== null && root.child('admins').child(auth.uid).val() === true",
      "loads": {
        "$entryId": { ".write": "!data.exists()" }
      },
      "errors": {
        "$entryId": { ".write": "!data.exists()" }
      }
    }
  }
}
